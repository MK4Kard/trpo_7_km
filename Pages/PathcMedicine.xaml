<Page x:Class="trpo_7.Pages.PathcMedicine"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:trpo_7.Pages"
      xmlns:m="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="PathcMedicine">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Label Content="Частичное изменение Препарата"/>
            <TextBox m:HintAssist.Hint="Название"/>
            <TextBox m:HintAssist.Hint="Производитель"/>
            <TextBox m:HintAssist.Hint="Цена"/>
            <TextBox m:HintAssist.Hint="Срок годности"/>
            <CheckBox Content="Наличие"/>
        </StackPanel>
        <Button Grid.Row="1" Content="Сохранить"/>
    </Grid>
</Page>
