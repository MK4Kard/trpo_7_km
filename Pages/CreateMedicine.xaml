<Page x:Class="trpo_7.Pages.CreateMedicine"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:trpo_7.Pages"
      mc:Ignorable="d" 
      xmlns:m="http://materialdesigninxaml.net/winfx/xaml/themes"
      d:DesignHeight="450" d:DesignWidth="800"
      DataContext="{Binding RelativeSource={RelativeSource Self}}"
      Title="CreateMedicine">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <Button Content="Выйти" Click="Back_Click"/>
        <StackPanel Grid.Row="1">
            <Label Content="Создание Препарата"/>
            <TextBox m:HintAssist.Hint="Название" Text="{Binding medicine.Name}"/>
            <TextBox m:HintAssist.Hint="Производитель" Text="{Binding medicine.Manufacturer}"/>
            <TextBox m:HintAssist.Hint="Цена" Text="{Binding medicine.Price}"/>
            <TextBox m:HintAssist.Hint="Срок годности" Text="{Binding medicine.ExpirationDate}"/>
            <CheckBox Content="Наличие" IsChecked="{Binding medicine.IsAvailable}"/>
        </StackPanel>
        <Button Grid.Row="2" Content="Создать" Click="Create_Click"/>
    </Grid>
</Page>
